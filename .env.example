# CHAPITRE+ — variables d'exemple (aucune secret de production)
# Copier vers .env et adapter si besoin.

COMPOSE_PROJECT_NAME=chapitre-plus

# PostgreSQL (1 serveur, 9 databases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chapitre
POSTGRES_PASSWORD=chapitre_dev_change_me

DATABASE_URL_IDENTITY=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_identity
DATABASE_URL_CATALOG=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_catalog
DATABASE_URL_DIFFICULTY=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_difficulty
DATABASE_URL_TRAINER=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_trainer
DATABASE_URL_SCHEDULING=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_scheduling
DATABASE_URL_BOOKING=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_booking
DATABASE_URL_RESOURCE=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_resource
DATABASE_URL_PAYMENT=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_payment
DATABASE_URL_NOTIFICATION=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5432/chapitre_notification

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=chapitre
RABBITMQ_PASSWORD=chapitre_dev_change_me
RABBITMQ_URL=amqp://chapitre:chapitre_dev_change_me@localhost:5673/
RABBITMQ_EXCHANGE=chapitre.events.v1

# Ports HTTP locaux
GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
DIFFICULTY_SERVICE_PORT=8003
TRAINER_SERVICE_PORT=8004
SCHEDULING_SERVICE_PORT=8005
BOOKING_SERVICE_PORT=8006
RESOURCE_SERVICE_PORT=8007
PAYMENT_SERVICE_PORT=8008
NOTIFICATION_SERVICE_PORT=8009

# Front
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Paiement (désactivé en phase 0)
PAYMENT_PROVIDER=disabled
ENVIRONMENT=development
