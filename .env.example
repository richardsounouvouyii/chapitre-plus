# CHAPITRE+ — variables d'exemple (aucune secret de production)
# Copier vers .env et adapter si besoin.

COMPOSE_PROJECT_NAME=chapitre-plus

# PostgreSQL (1 serveur, 9 databases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=chapitre
POSTGRES_PASSWORD=chapitre_dev_change_me

DATABASE_URL_IDENTITY=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_identity
DATABASE_URL_CATALOG=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_catalog
DATABASE_URL_DIFFICULTY=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_difficulty
DATABASE_URL_TRAINER=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_trainer
DATABASE_URL_SCHEDULING=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_scheduling
DATABASE_URL_BOOKING=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_booking
DATABASE_URL_RESOURCE=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_resource
DATABASE_URL_PAYMENT=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_payment
DATABASE_URL_NOTIFICATION=postgresql+psycopg://chapitre:chapitre_dev_change_me@localhost:5433/chapitre_notification

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=chapitre
RABBITMQ_PASSWORD=chapitre_dev_change_me
RABBITMQ_URL=amqp://chapitre:chapitre_dev_change_me@localhost:5673/
RABBITMQ_EXCHANGE=chapitre.events.v1

# Ports HTTP locaux
GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
DIFFICULTY_SERVICE_PORT=8003
TRAINER_SERVICE_PORT=8004
SCHEDULING_SERVICE_PORT=8005
BOOKING_SERVICE_PORT=8006
RESOURCE_SERVICE_PORT=8007
PAYMENT_SERVICE_PORT=8008
NOTIFICATION_SERVICE_PORT=8009

# Front
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Identity (JWT courts — changer le secret hors dev)
# ≥ 32 octets (HS256) — ne pas utiliser en production
IDENTITY_JWT_SECRET=dev-only-change-me-chapitre-identity-jwt-hs256
IDENTITY_JWT_ACCESS_TTL_MINUTES=15
IDENTITY_JWT_ISSUER=chapitre-identity
IDENTITY_INVITATION_TTL_HOURS=72
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8009
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
DIFFICULTY_SERVICE_URL=http://127.0.0.1:8003
TRAINER_SERVICE_URL=http://127.0.0.1:8004
SCHEDULING_SERVICE_URL=http://127.0.0.1:8005
# Difficulty → Catalog (validation synchrone des refs)
# CATALOG_SERVICE_URL déjà défini ci-dessus
DIFFICULTY_CATALOG_TIMEOUT_SECONDS=5
# Trainer inbox
TRAINER_DIFFICULTY_SUBMITTED_QUEUE=chapitre.trainer.difficulty.submitted
TRAINER_DIFFICULTY_SUBMITTED_DLQ=chapitre.trainer.difficulty.submitted.dlq
TRAINER_DIFFICULTY_SUBMITTED_ROUTING_KEY=difficulty.submitted.v1
IDENTITY_INTERNAL_SERVICE_KEY=dev-only-identity-internal-key
# Fernet (générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Prod : injecter via KMS / secret manager — ne jamais committer la clé prod.
IDENTITY_TOKEN_FERNET_KEY=Sm4U6LDdxF4Nl_ssn7aBlD5drfg4ul5ozH67ifpuSZw=

# Seed premier admin (script identity) — ne pas committer un vrai mot de passe
SEED_ADMIN_EMAIL=admin@chapitre.bj
SEED_ADMIN_PASSWORD=ChangeMeAdmin1

# Gateway anti-bruteforce login
GATEWAY_LOGIN_RATE_LIMIT=10
GATEWAY_LOGIN_RATE_WINDOW_SECONDS=60

# Paiement (désactivé en phase 0)
PAYMENT_PROVIDER=disabled
ENVIRONMENT=development
